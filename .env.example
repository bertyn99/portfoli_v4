# Production site URL (canonicals, sitemap, OG URLs) — required for deploy
NUXT_SITE_URL=https://bertynboulikou.com

# Nuxt SEO Pro MCP — key from https://nuxtseo.com/pro/dashboard (starts with nsp_)
NUXT_SEO_PRO_API_KEY=

# EmailJS (contact form)
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID_MYSELF=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID_VISITOR=
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Notion (devis / audit integrations)
NOTION_TOKEN=
NOTION_CLIENT_DB_ID=
NOTION_PROJECT_DB_ID=
